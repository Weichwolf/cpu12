file(READ "${INPUT}" bytes HEX)
string(LENGTH "${bytes}" remaining)
math(EXPR count "${remaining} / 2")
set(output "// SPDX-License-Identifier: GPL-3.0-only\nBitcode<${count}>{\n")
while(remaining GREATER 0)
  if(remaining GREATER 128)
    set(size 128)
  else()
    set(size ${remaining})
  endif()
  string(SUBSTRING "${bytes}" 0 ${size} chunk)
  string(SUBSTRING "${bytes}" ${size} -1 bytes)
  string(REGEX REPLACE "(..)" "0x\\1," chunk "${chunk}")
  string(APPEND output "${chunk}\n")
  string(LENGTH "${bytes}" remaining)
endwhile()
string(APPEND output "}\n")
file(WRITE "${OUTPUT}" "${output}")
